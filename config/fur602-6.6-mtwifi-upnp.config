# ===== FUR-602 单设备 + 全锥 NAT + 基础 AP 必备 =====

# 显式锁定 filogic 子目标（子树 SUBTARGETS:=filogic mt7622 mt7623 mt7629，默认即 filogic）

CONFIG_TARGET_mediatek_filogic=y

CONFIG_TARGET_mediatek_filogic_DEVICE_honor_fur-602=y

# 全锥内核模块（本地 vendor 包）+ 其内核依赖

CONFIG_NF_CONNTRACK_EVENTS=y

CONFIG_NF_CONNTRACK_CHAIN_EVENTS=y

# 基础路由/AP 必备
# ----------------------------------------------------------
# SSL 后端统一为 OpenSSL（修复 Run #2 的 package/install Error 255）。
# 原因：
#   * filogic 的 target.mk 在 DEFAULT_PACKAGES 里自带 wpad-openssl；
#     wget-ssl / openssl-util / libopenssl-* 也都走 OpenSSL。
#   * 而 luci-ssl 的 LUCI_DEPENDS := +luci-light +libustream-mbedtls
#     +px5g-mbedtls +luci-app-package-manager，会强制装 mbedtls 版。
#   * ustream-ssl 的三个 variant 是独立包（无 PROVIDES 虚拟名），
#     libustream-mbedtls 与 libustream-openssl 都安装同一个
#     /lib/libustream-ssl.so，opkg check_data_file_clashes 直接报错。
# 解法：换用 luci-ssl-openssl（+libustream-openssl +openssl-util），
#       全镜像只保留一种 libustream 实现，HTTPS LuCI 仍然可用。
# ----------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
# CONFIG_PACKAGE_luci-ssl is not set
CONFIG_PACKAGE_libustream-openssl=y
# CONFIG_PACKAGE_libustream-mbedtls is not set
# CONFIG_PACKAGE_px5g-mbedtls is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-mbedtls is not set
CONFIG_PACKAGE_kmod-nft-offload=y

# MT7981 硬件不支持 DVFS(定频1.3G,无OPP)，不装 cpufreq

# ==========================================================
# 本次新增：UPnP（24.10 / firewall4 + nftables 环境）
# 用户已确认：不加 SSR-Plus / HomeProxy / PassWall / 其它重型插件；
#             ttyd 保留（上游默认包带入，不额外添加也不显式剔除）；
#             主题实际为 luci-theme-bootstrap（该分支无 bootstrap-mod）。
# ==========================================================
CONFIG_PACKAGE_luci-app-upnp=y
# 24.10 里 miniupnpd 只是 PROVIDES 虚拟名，真实可选包是 nftables / iptables 两个变体。
# 本树是 firewall4 + nftables，必须用 miniupnpd-nftables（DEFAULT_VARIANT:=1）。
# luci-app-upnp 的 LUCI_DEPENDS:=+miniupnpd 会自动解析到该默认变体，这里显式锁定。
CONFIG_PACKAGE_miniupnpd-nftables=y
# CONFIG_PACKAGE_miniupnpd-iptables is not set
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
